<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Serve the gated ASP page by default; login.asp is the fallback -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.asp" />
        <add value="login.asp" />
      </files>
    </defaultDocument>
    <!-- Never list folder contents -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
